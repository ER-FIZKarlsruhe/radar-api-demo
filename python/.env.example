# Configuration for radar_api_demo.py (the notebook asks for credentials interactively instead).
# Copy this file to ".env" and fill in your values.
# ".env" is git-ignored - never commit real credentials!

# OAuth client (request one from info@radar-service.eu)
OAUTH_CLIENT_ID=<your-client-id>
OAUTH_CLIENT_SECRET=<your-client-secret>
OAUTH_CLIENT_REDIRECT_URL=<redirect-url-registered-for-your-client>

# RADAR user with a local password (Shibboleth users are NOT supported)
RADAR_USER_USERNAME=<your-username>
RADAR_USER_PASSWORD=<your-password>

# Target environment
CONTEXT_URL=https://test.radar-service.eu/radar
INGEST_URL=https://test.radar-service.eu/radar-ingest

# IDs of your contract and of an existing workspace (16 characters, e.g. sg7r0qqx30kvt67h)
CONTRACT_ID=<your-contract-id>
WORKSPACE_ID=<your-workspace-id>

# HTTP proxy (optional). Leave empty to use your system settings. In the notebook, set the proxy in its proxy cell.
# Format: http://proxy.example.org:8080 or http://user:password@proxy.example.org:8080
# HTTPS_PROXY is used for https:// URLs - the proxy URL itself usually still starts with http://
# NO_PROXY: comma separated hosts/domains that bypass the proxy, e.g. localhost,radar-service.eu
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=
